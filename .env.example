# Copy to .env and fill in the two secrets. Every other value is a sensible default.

# MongoDB connection string. Leave empty for a local MongoDB:
# the backend dev server uses mongodb://localhost:27017, docker compose uses its own mongo service.
# For Atlas paste the mongodb+srv://... URI here and run: docker compose up api --no-deps
MONGODB_URI=

# Database name inside the cluster.
MONGODB_DB_NAME=knowledge

# Gemini API key (Google AI Studio). Read by LiteLLM from the environment. Empty = AI calls fail and assets are saved as "failed".
GEMINI_API_KEY=

# LiteLLM model id used to describe files (description, tags, keywords, visible text, category).
LLM_MODEL=gemini/gemini-3.1-flash-lite

# LiteLLM model id used for text and image embeddings.
EMBEDDING_MODEL=gemini/gemini-embedding-2

# Vector size requested from the embedding model.
EMBEDDING_DIMENSIONS=768

# Upload limit for images in bytes (10 MB).
MAX_IMAGE_BYTES=10485760

# Upload limit for text files in bytes (1 MB).
MAX_TEXT_BYTES=1048576

# Images wider or taller than this many pixels are rejected.
MAX_IMAGE_PIXELS_SIDE=8000

# Text files longer than this many characters are sent to the model as head (16k) + tail (4k).
LLM_TEXT_INPUT_CHARS=20000

# Cap on the model answer; a cut-off answer marks the asset as failed.
LLM_MAX_OUTPUT_TOKENS=4096

# Timeout for one AI call.
LLM_TIMEOUT_SECONDS=60

# Retries for one AI call, with exponential backoff (covers rate limits).
LLM_MAX_RETRIES=3

# How many AI calls may run at the same time (keeps the free tier under its rate limit).
AI_CONCURRENCY=2

# Cosine similarity threshold for the semantic search list (measured: matches 0.47-0.57, noise <= 0.44).
SEMANTIC_MIN_SCORE=0.45

# Number of search results returned.
SEARCH_LIMIT=10

# Comma separated origins allowed to call the API (the Vite dev server by default).
CORS_ORIGINS=http://localhost:5173

# Port the server listens on. Cloud Run and docker compose set this themselves.
PORT=8000

# Local and smoke-test use only: replace the real AI client with a deterministic fake that needs no key.
# AI_CLIENT=fake
